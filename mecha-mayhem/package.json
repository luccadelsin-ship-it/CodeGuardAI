{
  "name": "mecha-mayhem",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server/index.ts",
    "smoke": "node scripts/smoke.mjs",
    "live": "node scripts/live.mjs",
    "build:artifact": "vite build --mode artifact && node scripts/artifact.mjs"
  },
  "type": "module",
  "dependencies": {
    "@babylonjs/core": "^9.33.2",
    "@babylonjs/havok": "^1.3.14",
    "@babylonjs/loaders": "^9.33.2",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.1",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
